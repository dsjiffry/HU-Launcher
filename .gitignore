# Build outputs
build/
*.apk
*.idsig

# Signing keys (each builder gets their own; never publish)
signing.keystore
*.keystore
*.jks

# Data pulled from your own head unit by pc/hu.ps1
pc/apps.json
pc/verdicts.json
pc/*.jpg
pc/*.log

# Screenshots and logs anywhere (they come from your own device). Icons are vector XML.
*.jpg
*.jpeg
*.png
*.webp
*.log

# ...except the README screenshots (taken on an emulator, no personal data)
!docs/screenshots/*.png

# Vendor APKs pulled for inspection (not ours to publish)
pc/apks/
