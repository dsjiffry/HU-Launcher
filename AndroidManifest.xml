<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hu.launcher"
    android:versionCode="23"
    android:versionName="2.7">

    <!-- The head unit reports "Android 13" but its framework is really Pie (API 28), so the code
         only uses API <= 28 and never branches on Build.VERSION.SDK_INT (it may be spoofed). -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

    <!-- LAN link to the PC for remote bloat decisions (only listens while you turn it on). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the debloater open the system uninstall dialog for user-installed apps. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- File manager: browse/rename/unzip, and hand APKs to the system installer. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- PC link keeps running while you use other apps (foreground service + notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Firewall restarts itself after a reboot if it was on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Activity screen: per-app screen time and data use (granted by you in Settings). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- "Keep stopped": silently ends background processes of apps Android won't let us disable. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:theme="@style/Theme.HU"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <activity android:name=".Home"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|mcc|mnc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".Debloat"
            android:exported="false"
            android:label="@string/debloat"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- File manager lives in its own process: its memory (listings, unzip buffers, text)
             never touches the launcher's, and Android can reclaim it without killing home. -->
        <activity android:name=".Files"
            android:exported="false"
            android:label="Files"
            android:process=":files"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
        <activity android:name=".TextViewer"
            android:exported="false"
            android:label="Text"
            android:process=":files"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
        <!-- Serves files to other apps (installer, players) with one-off read grants. -->
        <provider android:name=".FileShare"
            android:authorities="com.hu.launcher.files"
            android:exported="false"
            android:grantUriPermissions="true"
            android:process=":files" />

        <activity android:name=".Network"
            android:exported="false"
            android:label="@string/firewall"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
        <activity android:name=".Setup"
            android:exported="false"
            android:label="Setup"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
        <activity android:name=".NightSettings"
            android:exported="false"
            android:label="Night screen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
        <activity android:name=".Monitor"
            android:exported="false"
            android:label="Activity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
        <activity android:name=".CaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service android:name=".PcLink" android:exported="false" />

        <service android:name=".Firewall"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service android:name=".RemoteControl"
            android:exported="false"
            android:label="@string/remote_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/remote_accessibility" />
        </service>

        <!-- PC link: back on after an app update (only if it was on), same PIN. -->
        <receiver android:name=".PcLink$Updated" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Install results from the PackageInstaller session (PC link installs). -->
        <receiver android:name=".Installer$Result" android:exported="false" />
        <!-- "Update" button on the update notification. -->
        <receiver android:name=".Updater$Act" android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Notification access is the only way a third-party app may read another app's media
             session (track, album art, play state). Notifications themselves are ignored. -->
        <service android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
